# Copy to .env.development (default), .env.staging, or .env.production.
# The API loads .env.<NODE_ENV>, defaulting to development.

NODE_ENV=development
API_PORT=3333

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/northline_atlas?schema=public"

# JWT
ACCESS_SECRET_KEY=change_me_access_secret
REFRESH_SECRET_KEY=change_me_refresh_secret
JWT_ACCESS_TOKEN_EXPIRATION_TIME=5m
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d

# Signed webhook constraints
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_TOLERANCE_SECONDS=300
WORK_ITEM_MAX_ATTEMPTS=3

# HTTP Basic auth for the Swagger docs (/docs)
SWAGGER_USER=admin
SWAGGER_PASSWORD=change_me_swagger

# Shared password for seeded demo accounts
SEED_PASSWORD=password
